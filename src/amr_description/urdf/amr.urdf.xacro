<?xml version="1.0"?>
<!-- Differential-drive AMR for ROS 2 Jazzy + Gazebo Harmonic
     base_footprint -> base_link -> {left,right}_wheel_link, casters, lidar_link, imu_link -->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis -->
  <xacro:property name="chassis_l" value="0.40"/>
  <xacro:property name="chassis_w" value="0.28"/>
  <xacro:property name="chassis_h" value="0.12"/>
  <xacro:property name="chassis_z" value="0.07"/>
  <xacro:property name="chassis_m" value="6.0"/>

  <!-- Drive wheels (must match ros2_controllers.yaml) -->
  <xacro:property name="wheel_r" value="0.05"/>
  <xacro:property name="wheel_w" value="0.04"/>
  <xacro:property name="wheel_y" value="0.17"/>   <!-- separation = 0.34 m -->
  <xacro:property name="wheel_m" value="0.5"/>

  <!-- Casters -->
  <xacro:property name="caster_r" value="0.025"/>
  <xacro:property name="caster_x" value="0.15"/>
  <xacro:property name="caster_m" value="0.1"/>

  <!-- Sensors -->
  <xacro:property name="lidar_z" value="0.155"/>

  <material name="body"><color rgba="0.15 0.35 0.70 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ===================== base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z}"/>
      <mass value="${chassis_m}"/>
      <inertia ixx="${chassis_m*(chassis_w*chassis_w+chassis_h*chassis_h)/12}" ixy="0" ixz="0"
               iyy="${chassis_m*(chassis_l*chassis_l+chassis_h*chassis_h)/12}" iyz="0"
               izz="${chassis_m*(chassis_l*chassis_l+chassis_w*chassis_w)/12}"/>
    </inertial>
  </link>

  <!-- ===================== drive wheels ===================== -->
  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_m}"/>
        <!-- cylinder axis along y -->
        <inertia ixx="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" ixy="0" ixz="0"
                 iyy="${wheel_m*wheel_r*wheel_r/2}" iyz="0"
                 izz="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}"/>
      </inertial>
    </link>

    <!-- +velocity about +y drives the robot forward for both wheels -->
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${reflect*wheel_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left"  reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>

  <!-- ===================== casters (frictionless) ===================== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual><geometry><sphere radius="${caster_r}"/></geometry><material name="grey"/></visual>
      <collision><geometry><sphere radius="${caster_r}"/></geometry></collision>
      <inertial>
        <mass value="${caster_m}"/>
        <inertia ixx="${0.4*caster_m*caster_r*caster_r}" ixy="0" ixz="0"
                 iyy="${0.4*caster_m*caster_r*caster_r}" iyz="0"
                 izz="${0.4*caster_m*caster_r*caster_r}"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_r - wheel_r}"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear"  x="${-caster_x}"/>

  <!-- ===================== 2D LiDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.12414</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== IMU ===================== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_z}"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ===================== ros2_control: wheel encoders + velocity commands ===================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position"/>  <!-- encoder -->
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position"/>  <!-- encoder -->
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find amr_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
