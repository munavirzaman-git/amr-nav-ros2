<?xml version="1.0" ?>
<!-- Moving obstacle ("walking person" proxy). Spawned several times with different -name.
     VelocityControl  : listens on /model/<name>/cmd_vel   (gz.msgs.Twist)
     OdometryPublisher: publishes /model/<name>/odometry   (gz.msgs.Odometry)
     It is NOT in the static map, so the robot only knows about it from the LiDAR. -->
<sdf version="1.9">
  <model name="dynamic_obstacle">
    <link name="link">
      <inertial>
        <mass>10.0</mass>
        <inertia><ixx>0.31</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.31</iyy><iyz>0</iyz><izz>0.2</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
